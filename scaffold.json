			"recursive": true
		}
	],
	"categories": [
		{
			"from": "blog_system/categories",
			"to": "blog_system/categories",
			"recursive": true
		}
	],
	"tags": [
		{
			"from": "blog_system/tags",
			"to": "blog_system/tags",
			"recursive": true
		}
	],
	"comment": [
		{
			"from": "blog_system/comment",
